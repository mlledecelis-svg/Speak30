{
  "expo": {
    "name": "Mon plan alimentaire",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.foodplanapp.tnsstl",
      "infoPlist": {
        "NSCameraUsageDescription": "Photographier vos plats pour illustrer vos recettes",
        "NSPhotoLibraryUsageDescription": "Choisir une photo de plat pour vos recettes"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAF7F0"
      },
      "package": "com.emergent.foodplanapp.tnsstl",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F0",
          "dark": {
            "image": "./assets/brand/logo-light.png",
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/lucide",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisir une photo de plat pour vos recettes",
          "cameraPermission": "Photographier vos plats pour illustrer vos recettes"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}